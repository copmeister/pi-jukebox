[Unit]
Description=Install one validated Pi Jukebox release
After=network-online.target
Wants=network-online.target
ConditionPathExists=/home/admin/jukebox-data/updater/request.json

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/libexec/pi-jukebox-update-entrypoint
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
ReadWritePaths=/home/admin/pi-jukebox-releases /home/admin/jukebox-data/updater /var/lib/pi-jukebox-updater /run/lock

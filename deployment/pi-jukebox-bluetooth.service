[Unit]
Description=Pi Jukebox Bluetooth receiver control
After=bluetooth.service local-fs.target
Wants=bluetooth.service
Before=pi-jukebox-app.service
PartOf=pi-jukebox-app.service

[Service]
Type=simple
User=pi-jukebox-bt
Group=pi-jukebox-control
SupplementaryGroups=bluetooth
ExecStart=/usr/local/libexec/pi-jukebox-bluetooth-launcher
Restart=on-failure
RestartSec=3
RuntimeDirectory=pi-jukebox-bluetooth
RuntimeDirectoryMode=0750
UMask=0007
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
PrivateNetwork=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX
LockPersonality=true
ReadWritePaths=/run/pi-jukebox-bluetooth

[Install]
WantedBy=multi-user.target

[Unit]
Description=Pi Jukebox application
After=network.target local-fs.target

[Service]
Type=simple
User=admin
Group=admin
WorkingDirectory=/home/admin
EnvironmentFile=/home/admin/jukebox-data/jukebox.env
Environment=GH_CONFIG_DIR=/home/admin/.config/gh
Environment=GH_NO_UPDATE_NOTIFIER=1
Environment=GH_PROMPT_DISABLED=1
ExecStart=/usr/local/libexec/pi-jukebox-launcher
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/admin/jukebox-data -/mnt/jukebox

[Install]
WantedBy=multi-user.target

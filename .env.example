# Copy this file to .env for local development. Never commit .env.
PI_JUKEBOX_APP_NAME=Pi Jukebox
PI_JUKEBOX_ENVIRONMENT=development
PI_JUKEBOX_HOST=127.0.0.1
PI_JUKEBOX_PORT=8000
PI_JUKEBOX_DATA_DIRECTORY=./data
PI_JUKEBOX_FRONTEND_ORIGIN=http://127.0.0.1:5173

# No music folder is configured by default. Add your own existing folder only in .env.
# Use an absolute path; forward slashes are easiest on Windows. Do not commit .env.
# PI_JUKEBOX_MUSIC_LIBRARY_PATH=C:/Users/your-name/Music

# Copy this file to .env for local development. Never commit .env.
PI_JUKEBOX_APP_NAME=Pi Jukebox
PI_JUKEBOX_ENVIRONMENT=development
PI_JUKEBOX_HOST=127.0.0.1
PI_JUKEBOX_PORT=8000
PI_JUKEBOX_DATA_DIRECTORY=./data
PI_JUKEBOX_FRONTEND_ORIGIN=http://127.0.0.1:5173

# No music folder is configured by default. Add your own existing folder only in .env.
# Use an absolute path; forward slashes are easiest on Windows. Do not commit .env.
# PI_JUKEBOX_MUSIC_LIBRARY_PATH=C:/Users/your-name/Music

# Raspberry Pi CD ripping (leave unconfigured on Windows). The output must be
# inside both the genuine external mount and the configured music library.
# PI_JUKEBOX_MUSIC_LIBRARY_PATH=/mnt/jukebox/Music
# PI_JUKEBOX_OPTICAL_DRIVE_PATH=/dev/sr0
# PI_JUKEBOX_EXTERNAL_STORAGE_PATH=/mnt/jukebox
# PI_JUKEBOX_RIP_OUTPUT_PATH=/mnt/jukebox/Music
# Defaults to /mnt/jukebox/.pi-jukebox-rip-staging on the same filesystem.
# PI_JUKEBOX_RIP_STAGING_PATH=/mnt/jukebox/.pi-jukebox-rip-staging
PI_JUKEBOX_CD_MINIMUM_FREE_BYTES=2000000000
PI_JUKEBOX_CD_POLL_INTERVAL_SECONDS=3
PI_JUKEBOX_CD_PROCESS_NICE=10
PI_JUKEBOX_CD_DISCID_EXECUTABLE=cd-discid
PI_JUKEBOX_CD_EJECT_EXECUTABLE=eject
PI_JUKEBOX_CDPARANOIA_EXECUTABLE=cdparanoia
PI_JUKEBOX_FLAC_EXECUTABLE=flac
PI_JUKEBOX_METADATA_TIMEOUT_SECONDS=8
PI_JUKEBOX_METADATA_RETRY_COUNT=2

# Stable checks use the local service account's existing `gh` login. No token
# is stored here or sent to the browser. Installation stays disabled until a
# separately installed, fixed update helper has been reviewed and configured.
PI_JUKEBOX_UPDATE_REPOSITORY=copmeister/pi-jukebox
PI_JUKEBOX_UPDATE_CHECK_ENABLED=true
PI_JUKEBOX_UPDATE_INSTALL_ENABLED=false
PI_JUKEBOX_UPDATE_CHECK_DELAY_SECONDS=5
PI_JUKEBOX_UPDATE_TIMEOUT_SECONDS=8
# PI_JUKEBOX_UPDATE_HELPER_PATH=/usr/local/libexec/pi-jukebox-update
# PI_JUKEBOX_UPDATE_RELEASE_ROOT=/home/admin/jukebox-releases
